generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/**
 * =========================================================
 * ENUMS
 * =========================================================
 */

enum UserRole {
  USER
  ADMIN
}

enum AvailabilityStatus {
  AVAILABLE
  BUSY
  NOT_AVAILABLE
}

enum WorkMode {
  REMOTE
  ONSITE
  HYBRID
}

enum CollaborationPreference {
  INDIVIDUAL
  TEAM
  BOTH
}

enum ProjectSizePreference {
  SMALL
  MEDIUM
  LARGE
  ANY
}

enum ProfileVisibility {
  PUBLIC
  DEVELOPERS_ONLY
  PRIVATE
}

enum ProjectVisibility {
  PUBLIC
  PRIVATE
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum ProjectMemberRole {
  OWNER
  ADMIN
  DEVELOPER
  DESIGNER
  VIEWER
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskType {
  TASK
  BUG
  FEATURE
  IMPROVEMENT
}

enum NotificationType {
  PROJECT_INVITATION
  PROJECT_APPLICATION
  TEAM_INVITATION
  TASK_ASSIGNED
  TASK_UPDATED
  MESSAGE
  MENTION
  DEPLOYMENT
  SYSTEM
}

enum ConversationType {
  DIRECT
  PROJECT
  TEAM
}

enum WorkspaceFileType {
  FILE
  FOLDER
}

enum DeploymentStatus {
  QUEUED
  BUILDING
  DEPLOYING
  READY
  FAILED
  CANCELLED
}

enum BuildStatus {
  QUEUED
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
}

/**
 * =========================================================
 * AUTHENTICATION / USERS
 * =========================================================
 */

model User {
  id            String    @id @default(cuid())
  name          String?
  username      String?   @unique
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(USER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile Profile?

  accounts Account[]
  sessions Session[]

  userSkills UserSkill[]

  ownedProjects Project[] @relation("ProjectOwner")

  projectMemberships ProjectMember[]

  projectApplications ProjectApplication[]

  sentProjectInvitations     ProjectInvitation[] @relation("SentProjectInvitations")
  receivedProjectInvitations ProjectInvitation[] @relation("ReceivedProjectInvitations")

  ownedTeams      Team[]       @relation("TeamOwner")
  teamMemberships TeamMember[]

  sentTeamInvitations     TeamInvitation[] @relation("SentTeamInvitations")
  receivedTeamInvitations TeamInvitation[] @relation("ReceivedTeamInvitations")

  assignedTasks Task[] @relation("TaskAssignee")
  createdTasks  Task[] @relation("TaskCreator")

  taskComments TaskComment[]

  conversations ConversationMember[]

  messages Message[]

  notifications Notification[]

  ownedWorkspaces Workspace[] @relation("WorkspaceOwner")

  editorSessions EditorSession[]

  repositories Repository[]

  deployments Deployment[] @relation("UserDeployments")

  createdAttributions ProjectActivity[]
}

/**
 * =========================================================
 * AUTH.JS
 * =========================================================
 */

model Account {
  id                String @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String

  refresh_token String? @db.Text
  access_token  String? @db.Text
  expires_at    Int?
  token_type    String?
  scope         String?
  id_token      String? @db.Text
  session_state String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/**
 * =========================================================
 * DEVELOPER PROFILE
 * =========================================================
 */

model Profile {
  id     String @id @default(cuid())
  userId String @unique

  bio         String? @db.Text
  location    String?
  website     String?
  githubUrl   String?
  linkedinUrl String?

  availability AvailabilityStatus @default(AVAILABLE)

  workMode                WorkMode?
  collaborationPreference CollaborationPreference?
  preferredProjectSize    ProjectSizePreference?

  visibility ProfileVisibility @default(PUBLIC)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  roles      UserDeveloperRole[]
  lookingFor UserLookingFor[]
  interests  UserInterest[]
}

model Skill {
  id          String  @id @default(cuid())
  name        String  @unique
  category    String?
  description String?

  users UserSkill[]

  createdAt DateTime @default(now())
}

model UserSkill {
  id      String @id @default(cuid())
  userId  String
  skillId String

  level             Int @default(1)
  yearsOfExperience Int @default(0)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@index([skillId])
}

model DeveloperRole {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  users UserDeveloperRole[]

  createdAt DateTime @default(now())
}

model UserDeveloperRole {
  id        String @id @default(cuid())
  profileId String
  roleId    String

  profile Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  role    DeveloperRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([profileId, roleId])
  @@index([roleId])
}

model LookingFor {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  users UserLookingFor[]

  createdAt DateTime @default(now())
}

model UserLookingFor {
  id           String @id @default(cuid())
  profileId    String
  lookingForId String

  profile    Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  lookingFor LookingFor @relation(fields: [lookingForId], references: [id], onDelete: Cascade)

  @@unique([profileId, lookingForId])
  @@index([lookingForId])
}

model Interest {
  id          String  @id @default(cuid())
  name        String  @unique
  category    String?
  description String?

  users UserInterest[]

  createdAt DateTime @default(now())
}

model UserInterest {
  id         String @id @default(cuid())
  profileId  String
  interestId String

  profile  Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  interest Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@unique([profileId, interestId])
  @@index([interestId])
}

/**
 * =========================================================
 * PROJECTS
 * =========================================================
 */

model Project {
  id      String @id @default(cuid())
  ownerId String

  name        String
  slug        String  @unique
  description String? @db.Text

  visibility ProjectVisibility @default(PUBLIC)
  status     ProjectStatus     @default(PLANNING)

  repositoryUrl String?
  websiteUrl    String?

  maxMembers Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner User @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  members ProjectMember[]

  applications ProjectApplication[]

  invitations ProjectInvitation[]

  board Board?

  conversations Conversation[]

  workspace Workspace?

  repository Repository?

  deployments Deployment[]

  activities ProjectActivity[]

  @@index([ownerId])
  @@index([status])
  @@index([visibility])
}

model ProjectMember {
  id        String            @id @default(cuid())
  projectId String
  userId    String
  role      ProjectMemberRole @default(DEVELOPER)

  joinedAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model ProjectApplication {
  id        String @id @default(cuid())
  projectId String
  userId    String

  message String? @db.Text

  status ApplicationStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model ProjectInvitation {
  id         String @id @default(cuid())
  projectId  String
  senderId   String
  receiverId String

  message String? @db.Text

  status InvitationStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  sender User @relation("SentProjectInvitations", fields: [senderId], references: [id], onDelete: Cascade)

  receiver User @relation("ReceivedProjectInvitations", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([receiverId])
}

/**
 * =========================================================
 * TEAMS
 * =========================================================
 */

model Team {
  id      String @id @default(cuid())
  ownerId String

  name        String
  description String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner User @relation("TeamOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  members TeamMember[]

  invitations TeamInvitation[]

  @@index([ownerId])
}

model TeamMember {
  id     String @id @default(cuid())
  teamId String
  userId String

  role ProjectMemberRole @default(DEVELOPER)

  joinedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

model TeamInvitation {
  id         String @id @default(cuid())
  teamId     String
  senderId   String
  receiverId String

  status InvitationStatus @default(PENDING)

  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  sender User @relation("SentTeamInvitations", fields: [senderId], references: [id], onDelete: Cascade)

  receiver User @relation("ReceivedTeamInvitations", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([receiverId])
}

/**
 * =========================================================
 * KANBAN
 * =========================================================
 */

model Board {
  id        String @id @default(cuid())
  projectId String @unique

  name String @default("Project Board")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  columns BoardColumn[]
}

model BoardColumn {
  id      String @id @default(cuid())
  boardId String

  name     String
  position Float

  color String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)

  tasks Task[]

  @@index([boardId])
}

model Task {
  id            String @id @default(cuid())
  boardColumnId String

  creatorId  String
  assigneeId String?

  title       String
  description String? @db.Text

  type     TaskType     @default(TASK)
  priority TaskPriority @default(MEDIUM)

  position Float

  dueDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  boardColumn BoardColumn @relation(fields: [boardColumnId], references: [id], onDelete: Cascade)

  creator User @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Cascade)

  assignee User? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  comments TaskComment[]

  labels TaskLabel[]

  attachments TaskAttachment[]

  @@index([boardColumnId])
  @@index([assigneeId])
}

model TaskLabel {
  id String @id @default(cuid())

  name  String
  color String

  taskId String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model TaskComment {
  id     String @id @default(cuid())
  taskId String
  userId String

  content String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model TaskAttachment {
  id     String @id @default(cuid())
  taskId String

  name String
  url  String

  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

/**
 * =========================================================
 * CHAT
 * =========================================================
 */

model Conversation {
  id        String  @id @default(cuid())
  projectId String?

  type ConversationType

  name String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  members ConversationMember[]

  messages Message[]

  @@index([projectId])
}

model ConversationMember {
  id             String @id @default(cuid())
  conversationId String
  userId         String

  joinedAt DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

model Message {
  id             String @id @default(cuid())
  conversationId String
  senderId       String

  content String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
}

/**
 * =========================================================
 * NOTIFICATIONS
 * =========================================================
 */

model Notification {
  id     String @id @default(cuid())
  userId String

  type NotificationType

  title   String
  message String @db.Text

  read Boolean @default(false)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
}

/**
 * =========================================================
 * CLOUD IDE WORKSPACE
 * =========================================================
 */

model Workspace {
  id        String @id @default(cuid())
  projectId String @unique
  ownerId   String

  name String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  owner User @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  files WorkspaceFile[]

  environmentVariables EnvironmentVariable[]

  editorSessions EditorSession[]

  terminals Terminal[]

  @@index([ownerId])
}

model WorkspaceFile {
  id          String @id @default(cuid())
  workspaceId String

  parentId String?

  name String
  path String

  type WorkspaceFileType

  content String? @db.Text

  language String?

  size Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  parent WorkspaceFile? @relation("FileTree", fields: [parentId], references: [id], onDelete: Cascade)

  children WorkspaceFile[] @relation("FileTree")

  @@unique([workspaceId, path])
  @@index([parentId])
}

model EnvironmentVariable {
  id          String @id @default(cuid())
  workspaceId String

  key   String
  value String @db.Text

  secret Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
}

model Terminal {
  id          String @id @default(cuid())
  workspaceId String

  name String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model EditorSession {
  id          String @id @default(cuid())
  workspaceId String
  userId      String

  fileId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([userId])
}

/**
 * =========================================================
 * GIT / GITHUB
 * =========================================================
 */

model Repository {
  id        String @id @default(cuid())
  projectId String @unique
  userId    String

  provider String @default("github")

  name String
  url  String

  defaultBranch String @default("main")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/**
 * =========================================================
 * DEPLOYMENTS
 * =========================================================
 */

model Deployment {
  id        String @id @default(cuid())
  projectId String
  userId    String

  status DeploymentStatus @default(QUEUED)

  url String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  user User @relation("UserDeployments", fields: [userId], references: [id], onDelete: Cascade)

  builds Build[]

  @@index([projectId])
}

model Build {
  id           String @id @default(cuid())
  deploymentId String

  status BuildStatus @default(QUEUED)

  logs String? @db.Text

  startedAt  DateTime?
  finishedAt DateTime?

  createdAt DateTime @default(now())

  deployment Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  @@index([deploymentId])
}

/**
 * =========================================================
 * PROJECT ACTIVITY
 * =========================================================
 */

model ProjectActivity {
  id        String @id @default(cuid())
  projectId String
  userId    String

  action   String
  metadata Json?

  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([userId])
  @@index([createdAt])
}
